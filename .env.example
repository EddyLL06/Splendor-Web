NODE_ENV=development
APP_BASE_URL=http://localhost:5173

# Leave blank for same-origin / Vite-proxied API, lobby, and Socket.IO requests.
VITE_GAME_SERVER_URL=
GAME_SERVER_PORT=8000
GAME_ALLOWED_ORIGINS=http://localhost:5173

APP_DATA_DIR=.local-data
DATABASE_URL=file:./.local-data/database/app.sqlite
AVATAR_STORAGE_DIR=.local-data/avatars
UPLOAD_TEMP_DIR=.local-data/tmp

EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Gem Council <no-reply@auth.example.com>
EMAIL_REPLY_TO=

# Generate independent random values; never reuse or commit them.
SESSION_SECRET=
VERIFICATION_CODE_PEPPER=
GAME_CREDENTIAL_SECRET=

SESSION_DURATION_DAYS=30
VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_CODE_RESEND_SECONDS=60
VERIFICATION_CODE_MAX_ATTEMPTS=5

# AI bot runtime
AI_BOT_ENABLED=true
# auto = one worker per vCPU up to 8 (8 workers on the Railway 8-vCPU plan),
# one core kept free above 8, cap 16. NODE_ENV-independent (tests pin 0
# explicitly; local dev can set an explicit cap). Integers 0-16 override.
AI_BOT_WORKERS=auto
AI_BOT_QUEUE_LIMIT=256
AI_BOT_HARD_MAX_MS=80
# Expert difficulty uses the ds-search engine (PIMC-MCTS, no neural networks).
AI_BOT_EXPERT_ENABLED=true
# Legacy ONNX neural Expert is disabled; this path is no longer loaded.
AI_BOT_NEURAL_MODEL=ai_bot/models/neural/policy-attn-v3.onnx
# Simulation budget for one expert decision. Adaptive default: 25k per
# worker (8 workers = 200k, completes in ~6s at observed throughput — a
# clean finish inside the 8s wall clock). Set explicitly to override.
AI_BOT_EXPERT_SIMS=
# Seeded hidden-state determinizations per expert decision. Adaptive
# default: 3 per worker (the A/B-winning per-worker shape; 8 workers = 24).
AI_BOT_EXPERT_DETERMINIZATIONS=
# Expert search wall-clock budget per move (ms) — the safety net; the
# adaptive sims budget normally completes before it.
AI_BOT_EXPERT_MAX_MS=8000
