{
  "name": "gem-council",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0 --port 5173",
    "dev:server": "tsx watch src/server/server.ts",
    "build": "npm run data:generate && npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "config:local": "tsx scripts/ensure-local-env.ts",
    "storage:prepare": "tsx scripts/prepare-storage.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "npm run storage:prepare && prisma migrate dev",
    "prisma:migrate:deploy": "npm run storage:prepare && prisma migrate deploy",
    "typecheck": "npm run prisma:generate && tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "npm run prisma:generate && vitest run tests",
    "test:e2e": "npm run prisma:generate && playwright test",
    "test:e2e:serve": "tsx scripts/e2e-server.ts",
    "test:watch": "vitest tests",
    "data:generate": "tsx scripts/convert-game-data.ts",
    "start": "node dist-server/src/server/server.js"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.9.1",
    "@prisma/client": "7.9.1",
    "argon2": "0.45.1",
    "better-sqlite3": "12.11.1",
    "boardgame.io": "0.50.2",
    "i18next": "26.3.6",
    "koa-body": "8.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "resend": "6.18.1",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/koa": "2.15.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "jsdom": "30.0.1",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "argon2@0.45.1": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "prisma@7.9.1": true
  },
  "overrides": {
    "@koa/cors": "5.0.0",
    "socket.io": "4.8.3",
    "react-cookies": {
      "cookie": "2.0.1"
    },
    "svelte": "5.56.8"
  }
}
